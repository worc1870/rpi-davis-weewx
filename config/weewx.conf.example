# Sanitized example for the Raspberry Pi Davis ISS / RTL-SDR project.
# Replace site-specific values with your own.

[Station]
    location = REPLACE_ME
    latitude = 0.0
    longitude = 0.0
    altitude = 0, meter
    station_type = Rtldavis
    rain_year_start = 1
    week_start = 6

[StdReport]
    SKIN_ROOT = skins
    HTML_ROOT = /var/lib/weewx
    data_binding = wx_binding

    [[CleanCSV]]
        # Disabled: replaced by the native CSVLogger service.
        skin = CSV
        enable = false

    [[Defaults]]
        lang = en
        unit_system = metricwx

[StdConvert]
    # New archive database is stored in METRICWX units.
    target_unit = METRICWX

[StdArchive]
    archive_interval = 60
    record_generation = hardware
    loop_hilo = True
    data_binding = wx_binding

[DataBindings]
    [[wx_binding]]
        database = archive_sqlite
        table_name = archive
        manager = weewx.manager.DaySummaryManager
        schema = weewx.schemas.wview_extended.schema

[Databases]
    [[archive_sqlite]]
        database_name = weewx.sdb
        database_type = SQLite

[DatabaseTypes]
    [[SQLite]]
        driver = weedb.sqlite
        SQLITE_ROOT = /var/lib/weewx

[Rtldavis]
    cmd = /usr/local/bin/rtldavis -gain 40 -fc 50000
    channel = EU
    iss_channel = 7
    driver = user.rtldavis

[CSVLogger]
    filename = /var/lib/weewx/csv/weather-{year}-{month}.csv
    timezone = Europe/London
    decimals = 3

[Engine]
    [[Services]]
        prep_services = weewx.engine.StdTimeSynch
        data_services = ,
        process_services = weewx.engine.StdConvert, weewx.engine.StdCalibrate, weewx.engine.StdQC, weewx.wxservices.StdWXCalculate
        xtype_services = weewx.wxxtypes.StdWXXTypes, weewx.wxxtypes.StdPressureCooker, weewx.wxxtypes.StdRainRater, weewx.wxxtypes.StdDelta
        archive_services = weewx.engine.StdArchive, user.csvlogger.CSVLogger
        restful_services = weewx.restx.StdStationRegistry, weewx.restx.StdWunderground, weewx.restx.StdPWSweather, weewx.restx.StdCWOP, weewx.restx.StdWOW, weewx.restx.StdWOWBE, weewx.restx.StdAWEKAS
        report_services = weewx.engine.StdPrint, weewx.engine.StdReport
